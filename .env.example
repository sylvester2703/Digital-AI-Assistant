# Environment Variables Configuration
PROJECT_NAME="Personal AI Student & Career Assistant"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (Defaults to SQLite for local development; switch to PostgreSQL in production)
DATABASE_URL="sqlite:///./data.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/personal_assistant"

# Security & Authentication
JWT_SECRET="super-secret-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URL (for CORS)
FRONTEND_ORIGIN="http://localhost:3000"

# AI Provider Configuration (Optional: GEMINI, OPENAI, ANTHROPIC, or LOCAL_DETERMINISTIC)
AI_PROVIDER="GEMINI"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Google Integrations (OAuth 2.0)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google/callback"

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=""

# Storage Configuration
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
